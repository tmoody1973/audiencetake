{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiencetake.com/schemas/source.schema.json",
  "title": "Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "projectId", "runId", "origin", "url", "canonicalUrl", "domain", "title", "excerpt", "retrievedAt", "sourceType", "availability", "verificationStatus", "supportsClaimIds", "conflictsWithClaimIds", "externalCommentary"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "origin": { "enum": ["submitted", "parallel", "community_lead", "creator"] },
    "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "canonicalUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "domain": { "type": "string", "minLength": 1, "maxLength": 253 },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "excerpt": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "author": { "type": ["string", "null"], "maxLength": 240 },
    "publishedAt": { "type": ["string", "null"], "format": "date-time" },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "sourceType": { "enum": ["submitted_video", "official_project", "creator_profile", "editorial_coverage", "interview", "campaign", "comparable", "external_commentary", "other"] },
    "availability": { "enum": ["available", "unavailable", "restricted"] },
    "verificationStatus": { "enum": ["observed", "verified", "qualified", "conflicting", "unverified"] },
    "sourceRole": { "enum": ["primary_work", "commentary", "trade_reporting", "community", "creator_statement", "other"] },
    "sourceTier": { "enum": ["primary", "creator_authorized", "reputable_trade", "platform_metadata", "secondary", "community"] },
    "supportsClaimIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "conflictsWithClaimIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "externalCommentary": { "type": "boolean" },
    "queryProvenance": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "queryBatchId", "queryLabel"],
      "properties": {
        "provider": { "enum": ["parallel"] },
        "queryBatchId": { "type": "string", "minLength": 1 },
        "queryLabel": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "origin": { "const": "parallel" } }, "required": ["origin"] },
      "then": { "required": ["queryProvenance"], "properties": { "queryProvenance": { "type": "object" } } }
    },
    {
      "if": { "properties": { "origin": { "enum": ["submitted", "community_lead", "creator"] } }, "required": ["origin"] },
      "then": { "properties": { "queryProvenance": { "type": "null" } } }
    }
  ]
}
