{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiencetake.com/schemas/source.schema.json",
  "title": "Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "origin", "url", "title", "excerpt", "retrievedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "origin": { "enum": ["submitted", "parallel", "community_lead", "creator"] },
    "url": { "type": "string", "format": "uri" },
    "title": { "type": "string", "minLength": 1 },
    "excerpt": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "publishedAt": { "type": ["string", "null"], "format": "date-time" },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "externalCommentary": { "type": "boolean", "default": false }
  }
}
