{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiencetake.com/schemas/card-publication.schema.json",
  "title": "CardPublication",
  "description": "A versioned publication decision written atomically with the project's latest-card pointer. Failed decisions do not publish an empty card.",
  "type": "object",
  "additionalProperties": false,
  "required": ["publicationId", "runId", "projectId", "researchVersion", "attempt", "outcome", "usefulEvidence", "cardVersionId", "previousCardVersionId", "sourceIds", "claimIds", "pathwayIds", "missingSections", "retryEligible", "publicMessage", "fallbackUsed", "publishedAt"],
  "properties": {
    "publicationId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "researchVersion": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "outcome": { "enum": ["complete", "partial", "failed"] },
    "usefulEvidence": { "type": "boolean" },
    "cardVersionId": { "type": ["string", "null"] },
    "previousCardVersionId": { "type": ["string", "null"] },
    "sourceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "claimIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "pathwayIds": { "type": "array", "uniqueItems": true, "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
    "missingSections": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "retryEligible": { "type": "boolean" },
    "publicMessage": { "type": "string", "minLength": 1, "maxLength": 500 },
    "fallbackUsed": { "type": "boolean" },
    "fallbackLabel": { "type": "string" },
    "publishedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "complete" } }, "required": ["outcome"] },
      "then": { "properties": { "usefulEvidence": { "const": true }, "cardVersionId": { "type": "string", "minLength": 1 }, "pathwayIds": { "type": "array", "minItems": 3, "maxItems": 3 }, "missingSections": { "type": "array", "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "partial" } }, "required": ["outcome"] },
      "then": { "properties": { "usefulEvidence": { "const": true }, "cardVersionId": { "type": "string", "minLength": 1 }, "missingSections": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "failed" } }, "required": ["outcome"] },
      "then": { "properties": { "usefulEvidence": { "const": false }, "cardVersionId": { "type": "null" }, "sourceIds": { "type": "array", "maxItems": 0 }, "claimIds": { "type": "array", "maxItems": 0 }, "pathwayIds": { "type": "array", "maxItems": 0 }, "missingSections": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "fallbackUsed": { "const": true } }, "required": ["fallbackUsed"] },
      "then": { "required": ["fallbackLabel"], "properties": { "fallbackLabel": { "const": "Previously generated — live refresh unavailable." }, "previousCardVersionId": { "type": "string", "minLength": 1 } } }
    }
  ]
}
