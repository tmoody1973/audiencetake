{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiencetake.com/schemas/pathway.schema.json",
  "title": "Pathway",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "projectId", "runId", "order", "label", "format", "strategyKind", "proposedMedium", "crossFormat", "crossFormatClaimIds", "audience", "rationale", "supportingClaimIds", "comparableSourceIds", "strengths", "risks", "openQuestions", "confidence", "nextExperiment"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 1, "maximum": 3 },
    "label": { "type": "string", "minLength": 1, "maxLength": 160 },
    "format": { "type": "string", "minLength": 1, "maxLength": 160 },
    "strategyKind": { "enum": ["development", "distribution", "audience", "financing", "education", "adaptation"] },
    "proposedMedium": { "enum": ["documentary", "live_action", "animation", "hybrid", "unknown"] },
    "crossFormat": { "type": "boolean" },
    "crossFormatClaimIds": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "audience": { "type": "string", "minLength": 1, "maxLength": 500 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "supportingClaimIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "comparableSourceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "strengths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "risks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "openQuestions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "confidence": { "enum": ["low", "medium", "high"] },
    "nextExperiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "hypothesis", "method", "participantAction", "signal", "timebox"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "hypothesis": { "type": "string", "minLength": 1, "maxLength": 800 },
        "method": { "type": "string", "minLength": 1, "maxLength": 800 },
        "participantAction": { "type": "string", "minLength": 1, "maxLength": 500 },
        "signal": { "type": "string", "minLength": 1, "maxLength": 500 },
        "timebox": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    }
  }
}
