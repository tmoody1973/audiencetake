{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiencetake.com/schemas/research-event.schema.json",
  "title": "ResearchEvent",
  "description": "A safe, ordered Firestore event for public research progress. It must never contain prompts, hidden reasoning, secrets, or unreviewed personal data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "projectId", "sequence", "attempt", "stage", "status", "kind", "publicTitle", "publicSummary", "publicVisibility", "occurredAt"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "stage": { "type": "integer", "minimum": 1, "maximum": 6 },
    "status": { "enum": ["waiting", "active", "complete", "incomplete", "failed"] },
    "kind": { "enum": ["stage", "tool_receipt", "source_receipt", "warning", "publication"] },
    "publicTitle": { "type": "string", "minLength": 1, "maxLength": 120 },
    "publicSummary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "publicVisibility": { "enum": ["public"] },
    "toolName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "queryLabel": { "type": "string", "minLength": 1, "maxLength": 160 },
    "resultCount": { "type": "integer", "minimum": 0 },
    "sourceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "destination": { "type": "string", "minLength": 1, "maxLength": 500 },
    "occurredAt": { "type": "string", "format": "date-time" }
  }
}
