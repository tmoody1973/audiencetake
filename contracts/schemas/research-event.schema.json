{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiencetake.com/schemas/research-event.schema.json",
  "title": "ResearchEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequence", "stage", "status", "kind", "publicTitle", "publicSummary", "occurredAt"],
  "properties": {
    "sequence": { "type": "integer", "minimum": 1 },
    "stage": { "type": "integer", "minimum": 1, "maximum": 6 },
    "status": { "enum": ["waiting", "active", "complete", "incomplete", "failed"] },
    "kind": { "enum": ["stage", "tool_receipt", "source_receipt", "warning", "publication"] },
    "publicTitle": { "type": "string", "minLength": 1 },
    "publicSummary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "toolName": { "type": "string" },
    "queryLabel": { "type": "string" },
    "resultCount": { "type": "integer", "minimum": 0 },
    "occurredAt": { "type": "string", "format": "date-time" }
  }
}
