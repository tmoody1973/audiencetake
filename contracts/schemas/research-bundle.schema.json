{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiencetake.com/schemas/research-bundle.schema.json",
  "title": "ResearchBundle",
  "description": "The Web Researcher handoff with bounded Parallel query provenance and normalized public sources.",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "projectId", "researchVersion", "objective", "queryBatches", "sources", "toolReceipts", "limitations"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "researchVersion": { "type": "integer", "minimum": 1 },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 800 }
      }
    },
    "queryBatches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "label", "searchQueries", "sourceIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "provider": { "const": "parallel" },
          "label": { "type": "string", "minLength": 1, "maxLength": 160 },
          "searchQueries": { "type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 120 } },
          "sourceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "origin", "url", "canonicalUrl", "title", "excerpt", "publishedAt", "retrievedAt", "queryProvenance"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "origin": { "enum": ["submitted", "parallel"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "canonicalUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "excerpt": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "publishedAt": { "type": ["string", "null"], "format": "date-time" },
          "retrievedAt": { "type": "string", "format": "date-time" },
          "queryProvenance": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["provider", "queryBatchId", "queryLabel"],
                "properties": {
                  "provider": { "const": "parallel" },
                  "queryBatchId": { "type": "string", "minLength": 1 },
                  "queryLabel": { "type": "string", "minLength": 1, "maxLength": 160 }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": { "properties": { "origin": { "const": "parallel" } }, "required": ["origin"] },
            "then": { "properties": { "queryProvenance": { "type": "object" } } },
            "else": { "properties": { "queryProvenance": { "type": "null" } } }
          }
        ]
      }
    },
    "toolReceipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["toolName", "queryBatchId", "queryLabel", "resultCount", "sourceIds"],
        "properties": {
          "toolName": { "const": "Parallel Search" },
          "queryBatchId": { "type": "string", "minLength": 1 },
          "queryLabel": { "type": "string", "minLength": 1, "maxLength": 160 },
          "resultCount": { "type": "integer", "minimum": 0 },
          "sourceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
  }
}
