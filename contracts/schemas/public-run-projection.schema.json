{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiencetake.com/schemas/public-run-projection.schema.json",
  "title": "PublicRunProjection",
  "description": "The safe Firestore projection used to restore a durable public research screen.",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "projectId", "attempt", "researchVersion", "status", "currentStage", "completedStages", "missingStages", "publicFailureMessage", "projectSlug", "cardUrl", "retryEligible", "fallbackUsed", "updatedAt"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "researchVersion": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["queued", "running", "complete", "partial", "failed"] },
    "currentStage": { "type": "integer", "minimum": 1, "maximum": 6 },
    "completedStages": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 6 } },
    "missingStages": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 6 } },
    "publicFailureMessage": { "type": ["string", "null"], "maxLength": 500 },
    "projectSlug": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "cardUrl": { "type": ["string", "null"], "pattern": "^/projects/[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "retryEligible": { "type": "boolean" },
    "fallbackUsed": { "type": "boolean" },
    "fallbackLabel": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "complete" } }, "required": ["status"] },
      "then": { "properties": { "completedStages": { "type": "array", "minItems": 6, "maxItems": 6 }, "missingStages": { "type": "array", "maxItems": 0 }, "projectSlug": { "type": "string" }, "cardUrl": { "type": "string" } } }
    },
    {
      "if": { "properties": { "status": { "const": "partial" } }, "required": ["status"] },
      "then": { "properties": { "missingStages": { "type": "array", "minItems": 1 }, "projectSlug": { "type": "string" }, "cardUrl": { "type": "string" } } }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": { "properties": { "publicFailureMessage": { "type": "string", "minLength": 1 }, "missingStages": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "fallbackUsed": { "const": true } }, "required": ["fallbackUsed"] },
      "then": { "required": ["fallbackLabel"], "properties": { "fallbackLabel": { "const": "Previously generated — live refresh unavailable." } } }
    }
  ]
}
