rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePublishesActivity(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.publicActivity == true;
    }

    function isPublishedProject(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)) &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.publicationStatus == 'published' &&
        (!('moderationState' in get(/databases/$(database)/documents/projects/$(projectId)).data) ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.moderationState == 'clear');
    }

    // All application writes cross a trusted server boundary. The Admin SDK
    // performs authorization independently and is not governed by these rules.
    match /users/{uid} {
      // This collection contains public profile fields only. Authorization is
      // held in custom claims and roleAssignments, never in a readable profile.
      allow read: if resource.data.visibility == 'public';
      allow write: if false;
    }

    match /roleAssignments/{uid} {
      allow read, write: if false;
    }

    match /handles/{handle} {
      allow read, write: if false;
    }

    match /projects/{projectId} {
      allow read: if resource.data.publicationStatus == 'published' &&
        (!('moderationState' in resource.data) || resource.data.moderationState == 'clear');
      allow write: if false;
    }

    match /nominations/{nominationId} {
      allow read: if resource.data.visibility == 'public';
      allow write: if false;
    }

    match /researchRuns/{runId} {
      // Run leases, task names, failure details, and model metadata remain
      // server-only. Safe progress receipts are published through events.
      allow read, write: if false;
    }

    match /publicResearchRuns/{runId} {
      // This collection is a deliberately narrow server-authored projection.
      // Lease holders, task metadata, provider payloads, and prompts stay in
      // researchRuns and stageOutputs, which have no client read path.
      allow read: if resource.data.runId == runId &&
        resource.data.keys().hasAll([
          'runId', 'projectId', 'attempt', 'researchVersion', 'status',
          'currentStage', 'completedStages', 'missingStages',
          'publicFailureMessage', 'projectSlug', 'cardUrl', 'retryEligible',
          'fallbackUsed', 'updatedAt'
        ]) &&
        resource.data.keys().hasOnly([
          'runId', 'projectId', 'attempt', 'researchVersion', 'status',
          'currentStage', 'completedStages', 'missingStages',
          'publicFailureMessage', 'projectSlug', 'cardUrl', 'retryEligible',
          'fallbackUsed', 'fallbackLabel', 'updatedAt'
        ]);
      allow write: if false;
    }

    match /events/{eventId} {
      allow get: if resource.data.publicVisibility == 'public' &&
        resource.data.stage is int &&
        resource.data.stage >= 1 && resource.data.stage <= 6 &&
        resource.data.keys().hasAll([
          'runId', 'projectId', 'sequence', 'attempt', 'stage', 'status',
          'kind', 'publicTitle', 'publicSummary', 'publicVisibility', 'occurredAt'
        ]) &&
        resource.data.keys().hasOnly([
          'runId', 'projectId', 'sequence', 'attempt', 'stage', 'status',
          'kind', 'publicTitle', 'publicSummary', 'publicVisibility',
          'toolName', 'queryLabel', 'resultCount', 'sourceIds', 'destination',
          'occurredAt'
        ]);
      // Firestore list rules must be provable from query constraints and cannot
      // prove a document key allowlist. The server is the only writer and
      // contract-validates every public event; client queries must still bind
      // the explicit public marker.
      allow list: if resource.data.publicVisibility == 'public';
      allow write: if false;
    }

    match /sources/{sourceId} {
      allow read: if resource.data.visibility == 'public' &&
        isPublishedProject(resource.data.projectId);
      allow write: if false;
    }

    match /pathways/{pathwayId} {
      allow read: if resource.data.visibility == 'public' &&
        isPublishedProject(resource.data.projectId);
      allow write: if false;
    }

    match /scoutCards/{cardVersionId} {
      allow read: if resource.data.visibility == 'public' &&
        isPublishedProject(resource.data.projectId);
      allow write: if false;
    }

    match /follows/{followId} {
      allow read: if isPublishedProject(resource.data.projectId) &&
        (profilePublishesActivity(resource.data.uid) ||
          (signedIn() && resource.data.uid == request.auth.uid));
      allow write: if false;
    }

    match /commitments/{commitmentId} {
      allow read: if isPublishedProject(resource.data.projectId) &&
        (profilePublishesActivity(resource.data.uid) ||
          (signedIn() && resource.data.uid == request.auth.uid));
      allow write: if false;
    }

    match /pathwayVotes/{voteId} {
      allow read: if isPublishedProject(resource.data.projectId) &&
        (resource.data.visibility == 'public' ||
          (signedIn() && resource.data.uid == request.auth.uid));
      allow write: if false;
    }

    match /takes/{takeId} {
      allow read: if isPublishedProject(resource.data.projectId) &&
        (resource.data.status == 'published' ||
          (signedIn() && resource.data.uid == request.auth.uid));
      allow write: if false;
    }

    match /replies/{replyId} {
      allow read: if isPublishedProject(resource.data.projectId) &&
        (resource.data.status == 'published' ||
          (signedIn() && resource.data.uid == request.auth.uid));
      allow write: if false;
    }

    match /evidenceSuggestions/{suggestionId} {
      allow read: if isPublishedProject(resource.data.projectId) &&
        (resource.data.visibility == 'public' ||
          (signedIn() && resource.data.submittedByUid == request.auth.uid));
      allow write: if false;
    }

    match /claimRequests/{claimId} {
      allow read: if signedIn() && resource.data.requesterUid == request.auth.uid;
      allow write: if false;
    }

    match /creatorUpdates/{updateId} {
      allow read: if isPublishedProject(resource.data.projectId) &&
        (resource.data.status == 'published' ||
          (signedIn() && resource.data.creatorUid == request.auth.uid));
      allow write: if false;
    }

    match /reports/{reportId} {
      allow read: if signedIn() && resource.data.reporterUid == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
